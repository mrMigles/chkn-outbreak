{
  "name": "chkn-outbreak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "tsx watch server/index.ts --debug",
    "server:once": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/build-assets.mjs",
    "maps": "tsx tools/build-maps.ts",
    "shot": "node tools/shot.mjs",
    "bot": "tsx tools/bot.ts",
    "start": "tsx server/index.ts",
    "smoke": "node tools/smoke.mjs"
  },
  "dependencies": {
    "@colyseus/core": "^0.16.26",
    "@colyseus/schema": "^3.0.76",
    "@colyseus/ws-transport": "^0.16.5",
    "colyseus.js": "^0.16.22",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^26.6.3",
    "playwright": "^1.63.0",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vite": "^8.3.2"
  }
}
