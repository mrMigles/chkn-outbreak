    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@types/node": "^26.6.3",
    "colyseus.js": "^0.16.22",
    "phaser": "^3.90.0",
    "playwright": "^1.63.0",
    "typescript": "5.9",
    "vite": "^8.3.2"
  }
