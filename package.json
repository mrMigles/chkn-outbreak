{
  "name": "chkn-outbreak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "server": "tsx watch server/index.ts --debug",
    "server:once": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "assets": "node tools/build-assets.mjs",
    "maps": "tsx tools/build-maps.ts",
    "shot": "node tools/shot.mjs",
    "bot": "tsx tools/bot.ts",
    "start": "tsx server/index.ts",
    "smoke": "node tools/smoke.mjs",
    "check:coop": "tsx tools/check-coop.ts",
    "check:network": "tsx tools/check-network.ts",
    "check:network-ui": "node tools/check-network-ui.mjs",
    "check:art": "node tools/check-art.mjs",
    "check:office": "node tools/office-sample.mjs",
    "check:levels": "tsx tools/check-levels.ts",
    "check:combat": "tsx tools/check-combat.ts",
    "check:telegram": "tsx tools/check-telegram.ts",
    "check:campaign": "tsx tools/check-campaign.ts",
    "check:progress": "tsx tools/check-room-progress.ts",
    "check:polish": "tsx tools/check-polish.ts",
